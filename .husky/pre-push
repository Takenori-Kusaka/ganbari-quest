#!/usr/bin/env sh
# .husky/pre-push (#1879 で初出、#2598 で QA self-implement 第 8 弾 verify chain 追加)
#
# git push 直前に push アカウント検証 + 軽量 systematic verify chain を実行する。
#
# # 段階 1 (#1879): active gh アカウントが Takenori-Kusaka であることを検証
# QA アカウント (ganbariquestsupport-lab) のままでの push を機械的に防止し、
# その後の `gh pr create` での起票アカウント違反を構造的に発生させない。
#
# # 段階 2 (#2598、QA self-implement 第 8 弾): push 時自己検証 chain
# Dev が pre-ready CLI (#2633 第 5 弾) を skip した場合でも push レイヤで以下を機械検出:
#   1. origin/main rebase drift verify (#2557 stale cache / 本日 7+ 連続 BLOCK の root cause)
#   2. 本日 deploy 全 file 削除 0 verify (#2603 / #2628 第 4 弾 gate を branch ベースで実行)
#   3. PR body 11 セクション + AC 4 列 + 禁止語 + mojibake verify
#      (#2576 / #2586 / #2633 第 5 弾、PR が既に存在する場合のみ)
#   4. biome check (軽量 lint、重い vitest / playwright は CI 委ね)
#   5. eslint fast check (#3880、変更 file 絞り込み。tests/**/*.ts は hard-block =
#      CI 唯一の eslint merge blocker、src/**/*.{ts,svelte} は warn-only = CI continue-on-error 同格)
#
# # 設計境界 (Pre-PMF / ADR-0010 整合)
# 重い検査 (vitest / playwright / svelte-check / type-aware eslint #3877) は本 hook に **追加しない**。
# 理由: push 速度を保ち、BLOCK 早期検出と push hook cost のバランスを取る。
# 全 step は CI / `npm run pre-ready` が二重で実行する設計 (defense in depth)。
#
# # 既存 script 再利用 (二重定義回避)
#   - scripts/check-gh-account-before-pr.mjs (#1879)
#   - scripts/check-recent-deploy-deletion.mjs (#2603 / #2618 第 4 弾)
#   - scripts/check-pr-body.mjs (#2060 / #2576 / #2586)
#
# # 関連
#   - ADR-0022 amendment 1 / amendment 3 (#1879) / docs/sessions/qa-session.md
#   - ADR-0056 §F (本 PR で新設、push 時自己検証機構 SSOT)
#   - ADR-0030 (pre-ready CLI と本 hook の defense in depth 関係)
#   - #2598 (本実装、QA self-implement 第 8 弾、本日 7+ 連続 BLOCK 構造的予防)
#   - #2633 (第 5 弾 pre-ready Step 9 強化 — 本 hook と相補的に Dev / push 経路を 2 層化)
#   - #3880 (Step 2.5 eslint fast check、biome と対で shift-left。CI eslint 挙動を忠実 mirror)
#
# # bypass
# `git push --no-verify` で skip 可能だが、ADR-0026 で discouraged。
# 緊急 hotfix 等の極限ケースのみ。本日 7+ 連続 BLOCK の root cause 解消が目的のため、
# 通常 push で skip すると本 hook の存在意義を毀損する。

set -e

# ============================================================
# 段階 1: gh アカウント検証 (#1879)
# ============================================================
node scripts/check-gh-account-before-pr.mjs

# ============================================================
# 段階 2: push 時 systematic 自己検証 chain (#2598、QA self-implement 第 8 弾)
# ============================================================

echo "[pre-push] QA self-implement 第 8 弾 verify chain (#2598)"

# --- Step 2.0: base branch 解決 (#2959 / develop 二層 cutover #2870) ---
# develop 二層 (branch-strategy.md §3/§5) では feature branch は develop 向け、
# hotfix (fix/* from main) は main 向け。drift 検査 / deploy 削除 gate / biome 抽出の
# 比較 base を scripts/lib/ci/resolve-base-branch.mjs (SSOT) で解決する。
# 解決不能時 (offline 等) は main に fallback (従来挙動と同一)。
# hotfix の初回 push (PR 未作成 + develop 乖離) は `GANBARI_PR_BASE=main git push` で明示可。
BASE_BRANCH=$(node scripts/lib/ci/resolve-base-branch.mjs 2>/dev/null) || BASE_BRANCH="main"
echo "[pre-push] (0/3) base branch 解決: origin/$BASE_BRANCH (#2959)"

# --- Step 2.1: origin/<base> rebase drift verify (#2557 / 本日 7+ 連続 BLOCK の root cause) ---
# 本 step は git fetch を伴うため network access が前提。
# offline 環境では `git fetch` が fail し、本 hook 全体が exit するため
# offline で push したい場合は `--no-verify` を使うこと (ADR-0026 例外運用)。
echo "[pre-push] (1/3) origin/$BASE_BRANCH rebase drift verify"
git fetch origin "$BASE_BRANCH" --quiet 2>/dev/null || {
	echo "[pre-push] WARN: git fetch origin $BASE_BRANCH 失敗 (offline?) — rebase verify を skip"
	echo "          通常 push では network 接続を確認してください"
}

# origin/<base> が手元 branch に取り込まれているか検証
# MERGE_BASE = 手元 HEAD と origin/<base> の共通祖先
# BASE_HEAD = origin/<base> の最新 commit
# MERGE_BASE != BASE_HEAD なら手元は origin/<base> の最新を取り込んでいない
if MERGE_BASE=$(git merge-base "origin/$BASE_BRANCH" HEAD 2>/dev/null) && BASE_HEAD=$(git rev-parse "origin/$BASE_BRANCH" 2>/dev/null); then
	if [ "$MERGE_BASE" != "$BASE_HEAD" ]; then
		AHEAD_COMMITS=$(git rev-list --count "$MERGE_BASE..$BASE_HEAD" 2>/dev/null || echo "?")
		echo "[pre-push] FAIL: origin/$BASE_BRANCH が $AHEAD_COMMITS commits ahead (rebase drift)"
		echo "          対処: git fetch origin $BASE_BRANCH && git rebase origin/$BASE_BRANCH"
		echo "          理由: 本日 7+ 連続 BLOCK の root cause (#2557 / #2598)。"
		echo "                rebase せず push すると過去 merged PR を revert する diff が混入する。"
		echo "          base 誤判定の場合: GANBARI_PR_BASE=<main|develop> git push で明示 (#2959)"
		echo "          skip (非推奨): git push --no-verify (ADR-0026 で discouraged)"
		exit 1
	fi
	echo "[pre-push]     OK: origin/$BASE_BRANCH 同期済"
else
	echo "[pre-push] WARN: rebase verify を skip (offline / origin/$BASE_BRANCH 未取得)"
fi

# --- Step 2.2 / 2.3: PR が既に存在する場合のみ deploy 削除 + PR body verify ---
# 新規 branch の初回 push 時は PR 未作成のため両 step を skip する。
# 2nd push 以降 (Fix Agent 修正 push 等) は PR が存在するため verify を実行する。
PR_NUM=""
if command -v gh >/dev/null 2>&1; then
	# `gh pr view` の exit code が 0 なら PR が存在する。
	# 失敗時 (PR 未作成 / network 未接続) は PR_NUM 空のまま step を skip する。
	PR_NUM=$(gh pr view --json number -q .number 2>/dev/null || echo "")
fi

if [ -n "$PR_NUM" ]; then
	echo "[pre-push] (2/3) 本日 deploy 全 file 削除 0 verify (PR #$PR_NUM)"
	# 本 step は本日 merged PR の全 file 削除を検出する (#2603 第 4 弾 gate)。
	#
	# #2877: 削除判定は three-dot (merge-base) diff `<base>...HEAD` で「PR 自身の削除」のみを
	# 検出する。two-dot (端点比較) は sibling PR が main に追加した file が HEAD tree に無いだけで
	# 偽陽性 BLOCK していた (単日 4 PR #2853/#2857/#2855/#2859 連続誤 BLOCK) が、three-dot 化で
	# main 進化を PR の削除と誤算入しなくなった。意図的削除は three-dot でも D として検出維持される。
	#
	# #2647 hotfix (第 9 弾): `--pr "$PR_NUM"` 引数は **付与しない**。
	# 理由: `--pr <N>` 指定時は worktree HEAD = remote PR HEAD verify gate (#2618 第 4 弾) が走るが、
	# push 前 hook 経路では local が rebase + new commit を持つため worktree HEAD ≠ remote PR HEAD
	# となり構造的に常時 BLOCK + Fix Agent が `--no-verify` 強制利用 = hook 自身が QA 機構毀損。
	# 引数なしで呼ぶと verify gate skip + 削除 check のみ実行され、push 前 hook 意図と整合する。
	# defense in depth は CI 経路 + QM Re-Review / Fix Agent worktree mode で `--pr` 付き gate が
	# 真正実行 (PR HEAD = checkout HEAD 一致) されるため失われない。詳細は ADR-0056 §F 補足参照。
	# #2959: 比較 base は解決済み base branch (develop 基点 branch で sibling PR の
	# develop commit を自 PR の削除と誤算入しないため)。deploy file list 自体は
	# script 内部で本日 deploy tag (main) から取得されるため意味は不変。
	#
	# #3832: intentional migration teardown exemption。develop 二層で main live な feature を
	# 意図的に撤去する PR は、撤去 commit の message 末尾に `Deploy-Teardown: <path-regex> #<issue>`
	# trailer を書けば、gate が宣言 path の削除を exempt する (引数不要、gate が commit trailer を
	# 自動で読む)。宣言外の削除は BLOCK 維持。これにより full `--no-verify` (この account check
	# 段階 1 まで飛ぶ) を使わずに正当な移管撤去を通せる。詳細は ADR-0056 §G / Issue #3832。
	RECENT_DEPLOY_CHECK_BASE="origin/$BASE_BRANCH" node scripts/check-recent-deploy-deletion.mjs || {
		EXIT_CODE=$?
		echo "[pre-push] FAIL: 本日 deploy 全 file 削除検出 (exit $EXIT_CODE)"
		echo "          対処: 削除した file が本日 merged の effort を revert していないか確認"
		echo "                false positive の場合は --ignore-pattern で除外指定"
		exit 1
	}
	echo "[pre-push]     OK: 本日 deploy 削除 0 件"

	echo "[pre-push] (3/3) PR body 11 セクション + AC 4 列 + 禁止語 + PO 決裁ブリーフ verify (PR #$PR_NUM)"
	# 本 step は PR body の 11 セクション網羅 + AC 4 列 + 禁止語 0 件 + mojibake 不在を検証する
	# (#2060 / #2576 / #2586 / #2633 第 5 弾)。
	# #3962: `po-decision:required` label 付き PR の PO 決裁ブリーフ欠落もここで落ちる
	# (label は labeler.yml が自動付与するため、body 側の追従漏れが #3944 / #3956 で 2 回連続した)。
	#
	# #4121 (ADR-0056 §F 改訂): Ready 化要件 (Ready チェックリスト全 [x] / PO 決裁ブリーフ) は
	# `--skip-ready-only` で **Draft / Ready を問わず push レイヤでは検査しない**。
	# 同じ section は pr-merge-gate.yml → check-merge-gate-checklist.mjs の LIGHT_LANE_SECTIONS が
	# CI で検査済で純粋な重複であり、外しても検査は 1 件も減らない。加えて Ready 時点の申告を
	# push 時点で問うのは検査の置き場所の誤りで、Draft へ 1 commit 置くだけで Ready 申告を要求され
	# 成果物が local に滞留していた (#3989 / #3997 は Draft 限定の対症だった)。
	# 体裁 / 事実性の検査 (セクション網羅 / AC 4 列 / 禁止語 / mojibake / 変更タイプ) は引き続き落ちる。
	# skip したことは check-pr-body の標準出力に必ず出る (無言 skip にしない)。
	node scripts/check-pr-body.mjs --pr "$PR_NUM" --skip-mergeable --skip-ready-only || {
		EXIT_CODE=$?
		echo "[pre-push] FAIL: PR body 検証 fail (exit $EXIT_CODE)"
		echo "          対処: tmp/pr-bodies/<slug>.md を編集 + gh pr edit --body-file"
		echo "                詳細: .claude/skills/dev-open-pr/SKILL.md §「Ready 化前必須」"
		exit 1
	}
	echo "[pre-push]     OK: PR body 11 セクション + AC 4 列 + 禁止語 0 件 + PO 決裁ブリーフ"
else
	echo "[pre-push] (2/3) PR 未作成のため deploy 削除 / PR body verify を skip"
	echo "[pre-push] (3/3) (同上)"
fi

# --- Step 2.4: biome check (軽量 lint、変更 file 絞り込み) ---
# 重い svelte-check / vitest / playwright は CI 委ね。
# biome check のみ push レイヤで実行することで CI で初めて lint fail に気づく事故を予防。
# origin/<base>...HEAD (three-dot) で変更 file を抽出し、biome 対象拡張子のみ check (Pre-PMF 整合、push 速度保持)。
# #2959: base は Step 2.0 で解決済み。three-dot 化で base 側の進行 commit を誤算入しない。
echo "[pre-push] biome check (軽量 lint、変更 file 絞り込み)"
if command -v npx >/dev/null 2>&1; then
	# 変更 file 抽出 (added / modified、削除 file は対象外)
	CHANGED_LINT_FILES=$(git diff --name-only --diff-filter=AM "origin/$BASE_BRANCH...HEAD" 2>/dev/null | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|svelte|css|json|jsonc)$' || true)
	if [ -n "$CHANGED_LINT_FILES" ]; then
		echo "$CHANGED_LINT_FILES" | head -5
		echo "$CHANGED_LINT_FILES" | xargs npx biome check 2>&1 | tail -3 || {
			echo "[pre-push] FAIL: biome check fail"
			echo "          対処: npx biome check --write <file> で自動修正"
			exit 1
		}
		echo "[pre-push]     OK: biome check (lint 対象 file)"
	else
		echo "[pre-push]     OK: biome 対象 file 変更なし、skip"
	fi
else
	echo "[pre-push] WARN: npx 未インストール、biome check skip"
fi

# --- Step 2.5: eslint fast check (変更 file 絞り込み、#3880) ---
# biome (Step 2.4) と対で eslint も push レイヤで実行し、CI で初めて eslint 違反に気づく
# 往復を減らす (shift-left)。CI (.github/workflows/ci.yml) の eslint 挙動を忠実に mirror し、
# 「hook が CI merge policy より strict」= --no-verify 常態化を招く事故を避けるため 2 段構成:
#
#   (A) hard-block: tests/**/*.ts (Playwright rules)。CI は `npx eslint "tests/**/*.ts"` を
#       continue-on-error 無しで走らせる唯一の eslint merge blocker (baseline 0 error)。
#       変更 file の部分集合を push 前に block して shift-left する。
#   (B) warn-only: src/**/*.{ts,svelte}。CI は SonarJS / local design rules を
#       continue-on-error で走らせる。svelte recommended (svelte/*) は #3878 で bulk
#       suppressions により hard gate 化したが、同 .svelte file に同居する local design
#       rules (no-raw-button 等) は依然 continue-on-error のため、hook 側は「hook が CI
#       より strict にならない」原則 (--no-verify 常態化回避) を優先し warn-only を維持する
#       (新規 svelte/* 違反の hard block は CI lint:svelte が担う)。hook は違反表示のみ。
#
# 設計境界 (ADR-0030 / ADR-0010 / ADR-0007): 型情報ロードを要する type-aware rules
# (#3877 で導入する parserOptions.project 系) は現 eslint.config.js に不在で、本 hook は fast rules
# のみ走らせる (変更 file 数件で ~8s、type-aware は CI 限定側 #3877 に置き hook を遅くしない)。
# 重い svelte-check / vitest / playwright は従来どおり CI / npm run pre-ready 委ね (defense in depth)。
# 抽出は既存 biome step と同じ three-dot (origin/<base>...HEAD)。base は Step 2.0 で解決済み。
echo "[pre-push] eslint fast check (変更 file 絞り込み、#3880)"
if command -v npx >/dev/null 2>&1; then
	CHANGED_ESLINT_FILES=$(git diff --name-only --diff-filter=AM "origin/$BASE_BRANCH...HEAD" 2>/dev/null || true)
	# (A) hard-block: tests/**/*.ts (CI 唯一の eslint merge blocker、green baseline)
	CHANGED_TEST_TS=$(echo "$CHANGED_ESLINT_FILES" | grep -E '^tests/.*\.ts$' || true)
	if [ -n "$CHANGED_TEST_TS" ]; then
		echo "$CHANGED_TEST_TS" | head -5
		if ! echo "$CHANGED_TEST_TS" | xargs npx eslint; then
			echo "[pre-push] FAIL: eslint (tests/**/*.ts, Playwright rules) 違反"
			echo "          対処: npx eslint --fix <file> (no-wait-for-timeout / no-networkidle 等は手修正)"
			echo "          理由: CI の tests eslint は continue-on-error 無し = merge blocker。"
			echo "          skip (非推奨): git push --no-verify (ADR-0026 で discouraged)"
			exit 1
		fi
		echo "[pre-push]     OK: eslint (tests/**/*.ts)"
	fi
	# (B) warn-only: src/**/*.{ts,svelte} (CI continue-on-error 同格、block しない)
	CHANGED_SRC_LINT=$(echo "$CHANGED_ESLINT_FILES" | grep -E '^src/.*\.(ts|svelte)$' || true)
	if [ -n "$CHANGED_SRC_LINT" ]; then
		if echo "$CHANGED_SRC_LINT" | xargs npx eslint; then
			echo "[pre-push]     OK: eslint (src 変更 file、違反なし)"
		else
			echo "[pre-push]     WARN: src eslint 違反あり (上記)。CI continue-on-error 同格で block しない。"
			echo "                 push 前に npx eslint --fix <file> での修正を推奨 (design rules / SonarJS)。"
		fi
	fi
	if [ -z "$CHANGED_TEST_TS" ] && [ -z "$CHANGED_SRC_LINT" ]; then
		echo "[pre-push]     OK: eslint 対象 file 変更なし、skip"
	fi
else
	echo "[pre-push] WARN: npx 未インストール、eslint check skip"
fi
echo "[pre-push] OK: QA self-implement 第 8 弾 verify chain 全 PASS (#2598)"
